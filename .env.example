# ==================== API Keys ====================
# Set at least one. Providers with no key are skipped automatically.
GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ==================== Models ====================
# The fallback chains in config/settings.py read these values, so this file
# is the only place you need to change a model.
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GOOGLE_LLM_MODEL=gemini-3.7-flash
GOOGLE_VISION_MODEL=gemini-3.7-flash
ANTHROPIC_LLM_MODEL=claude-opus-5
ANTHROPIC_VISION_MODEL=claude-opus-5

# Local models via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_VISION_MODEL=llava

# ==================== Offline mode ====================
# True = use only models running on this machine (Ollama / Tesseract); Groq,
# Gemini and Claude are skipped even if a key is set above. This is only the
# startup default - an admin can flip it at runtime in
# Admin Dashboard -> Local models, and that choice wins from then on.
OFFLINE_MODE=False

# ==================== Generation ====================
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=16000

# ==================== TLS / Corporate proxy ====================
# On a network that inspects TLS, Python fails with CERTIFICATE_VERIFY_FAILED
# because it does not read the OS certificate store. Point this at a PEM
# bundle containing your corporate root CA. See README -> "Corporate
# networks and TLS". Leave blank on normal networks.
CA_BUNDLE=

# ==================== Authentication ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run
SESSION_TIMEOUT_MINUTES=120

# ==================== Storage ====================
MAX_UPLOAD_SIZE=10485760

# ==================== OCR ====================
# Only needed if the tesseract binary is not on PATH.
TESSERACT_PATH=

# ==================== App ====================
APP_NAME=Architecture Diagram Builder
DEBUG=False
LOG_LEVEL=INFO
